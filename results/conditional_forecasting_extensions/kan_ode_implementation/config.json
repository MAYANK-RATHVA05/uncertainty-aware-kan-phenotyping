{
  "model": {
    "name": "LatentKANODE",
    "input_kind": "temporal",
    "kwargs": {
      "n_wearable_features": 48,
      "n_static_features": 63,
      "hidden_width": 16,
      "grid_intervals": 8,
      "spline_degree": 3,
      "grid_range": [
        -3.0,
        3.0
      ],
      "step_size": 0.25
    },
    "workflow": "conditional_relative_month_latent_KAN_ODE_smoke",
    "state_equation": "dh/dt = KANLinear(16,16)(h)",
    "state_order": [
      "h0",
      "h1_before",
      "h1_after",
      "h2_before",
      "h2_after",
      "h3"
    ],
    "observation_updates": "shared KAN(48,16) and shared conventional GRUCell at SM1 and SM2",
    "static_context": "KAN(63,16) initializes h0 once, not a time step",
    "times": [
      0,
      1,
      2,
      3
    ],
    "time_units": "relative study-month coordinates, not dates",
    "target": "measured SM3 PHQ-9 severity; endpoint-only MSE",
    "output": "unbounded scalar, no clipping or rounding",
    "dynamics_initialization": {
      "base_and_spline_scale": 0.01,
      "bias": 0.0
    },
    "solver": {
      "algorithm": "local classical fixed-step RK4",
      "implementation_version": "1.0",
      "step_size": 0.25,
      "differentiation": "direct PyTorch autograd, not adjoint",
      "final_partial_step": true,
      "zero_duration_identity": true,
      "maintained_dependencies_checked_not_installed": [
        "torchdiffeq",
        "torchode",
        "torchdyn"
      ]
    },
    "attribution": {
      "authors": [
        "Benjamin C. Koenig",
        "Suyong Kim",
        "Sili Deng"
      ],
      "paper": "https://arxiv.org/abs/2407.04192v3",
      "equations": "Section II, equations 4-9, physical pages 4-5",
      "adaptation_not_replication": true
    }
  },
  "training": {
    "task": "regression",
    "max_epochs": 2,
    "batch_size": 128,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "patience": 10,
    "seed": 42,
    "device": "cpu",
    "num_threads": 2,
    "min_delta": 0.0,
    "gradient_clip": 5.0,
    "binary_loss": "focal",
    "focal_alpha": 0.25,
    "focal_gamma": 2.0,
    "regression_loss": "mse"
  },
  "participant_selection": {
    "budget": 128,
    "seed": 42,
    "method": "permutation of sorted unique saved training IDs; retain all their rows",
    "outcomes_used": false
  },
  "counts": {
    "saved_training": {
      "samples": 5111,
      "participants": 2025
    },
    "smoke_training": {
      "samples": 340,
      "participants": 128
    },
    "validation": {
      "samples": 851,
      "participants": 338
    }
  },
  "dataset_protocol": {
    "study_type": "conditional_relative_month_forecasting",
    "available_at_timestamps_verified": false,
    "prospective_clinical_validation": false,
    "assumptions": {
      "assume_release_index_mapping": true,
      "assume_historical_features_available_by_sm2": true,
      "assume_sm0_phq_available_by_sm2": true,
      "assume_enrollment_demographics": true,
      "evidence_reference": "docs/temporal_feasibility.md"
    },
    "cutoff": "SM2 after conditional availability of the SM2 historical packet",
    "horizon": "one relative study-month interval; not a fixed elapsed-day duration",
    "target": "measured SM3 PHQ-9 severity (phq9_score_end), not change",
    "baseline": "measured SM0 phq9_score_start stored on the same quarter's endpoint row",
    "demographics": "enrollment screener copy from SM1 only; no future-row backfill",
    "baseline_demographics_source": "SM1 copy of assumed enrollment responses",
